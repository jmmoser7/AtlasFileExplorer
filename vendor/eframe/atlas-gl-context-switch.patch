+/// Glutin compares both the WGL context and the selected provider's bound device context.
+fn surface_is_current(
+    gl_context: &glutin::context::PossiblyCurrentContext,
+    gl_surface: &glutin::surface::Surface<glutin::surface::WindowSurface>,
+) -> bool {
+    #[cfg(target_os = "windows")]
+    if always_switch_gl_context() {
+        return false;
+    }
+
+    gl_surface.is_current(gl_context)
+}
+
+/// ATLAS PATCH: `ATLAS_GL_ALWAYS_SWITCH=1` restores upstream's behavior of
+/// re-binding the context on every call, for A/B diagnosis of driver problems.
+#[cfg(target_os = "windows")]
+fn always_switch_gl_context() -> bool {
+    static ALWAYS_SWITCH: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ALWAYS_SWITCH.get_or_init(|| {
+        std::env::var_os("ATLAS_GL_ALWAYS_SWITCH").is_some_and(|value| value != "0")
+    })
+}
