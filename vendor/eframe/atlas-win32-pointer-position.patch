@@ -251,0 +292,26 @@ impl EpiIntegration {
+        #[cfg(target_os = "windows")]
+        if let WindowEvent::MouseInput {
+            device_id,
+            button: MouseButton::Left,
+            state: ElementState::Pressed,
+        } = event
+        {
+            let event_count = egui_winit.egui_input().events.len();
+            let response = egui_winit.on_window_event(window, event);
+            // Supported buttons append an event only if egui-winit has a pointer
+            // position. Windows can deliver a press before the next cursor move.
+            if egui_winit.egui_input().events.len() == event_count {
+                if let Some(position) = native_client_press_position(window) {
+                    let _ = egui_winit.on_window_event(
+                        window,
+                        &WindowEvent::CursorMoved {
+                            device_id: *device_id,
+                            position,
+                        },
+                    );
+                    return egui_winit.on_window_event(window, event);
+                }
+            }
+            return response;
+        }
