@@ -107,0 +124,24 @@ impl FileDialog {
+
+    /// Whether a Windows save dialog asks before choosing an existing file.
+    /// Defaults to true. Other platform backends currently ignore this policy.
+    /// Disabling confirmation does not provide collision-safe file publication.
+    pub fn set_confirm_overwrite(mut self, confirm: bool) -> Self {
+        self.confirm_overwrite = confirm;
+        self
+    }
+}
