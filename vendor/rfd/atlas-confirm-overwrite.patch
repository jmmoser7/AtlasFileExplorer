+#[cfg(test)]
+mod overwrite_tests {
+    use super::*;
+
+    #[test]
+    fn unique_save_changes_only_the_windows_overwrite_prompt_flag() {
+        super::super::super::utils::init_com(|| {
+            let ordinary = IDialog::build_save_file(&FileDialog::default()).unwrap();
+            let unique =
+                IDialog::build_save_file(&FileDialog::new().set_confirm_overwrite(false)).unwrap();
+            let ordinary_options = unsafe { ordinary.0.options().unwrap() };
+            let unique_options = unsafe { unique.0.options().unwrap() };
+            assert_ne!(ordinary_options & FOS_OVERWRITEPROMPT, 0);
+            assert_eq!(unique_options, ordinary_options & !FOS_OVERWRITEPROMPT);
+        })
+        .unwrap();
+    }
+}
