+#[cfg(test)]
+mod overwrite_tests {
+    use super::FileDialog;
+
+    #[test]
+    fn overwrite_confirmation_is_opt_out() {
+        assert!(FileDialog::default().confirm_overwrite);
+        assert!(FileDialog::new().confirm_overwrite);
+        assert!(
+            !FileDialog::new()
+                .set_confirm_overwrite(false)
+                .confirm_overwrite
+        );
+    }
